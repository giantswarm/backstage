{
  "name": "root",
  "version": "0.138.0",
  "private": true,
  "engines": {
    "node": "22 || 24"
  },
  "scripts": {
    "start": "yarn env-cmd yarn backstage-cli repo start",
    "build:backend": "yarn workspace backend build",
    "build:backend-headless-service": "yarn workspace backend-headless-service build",
    "build:all": "backstage-cli repo build --all",
    "build-image": "yarn workspace backend build-image",
    "tsc": "scripts/tsc.sh",
    "tsc:full": "scripts/tsc.sh --skipLibCheck false --incremental false",
    "clean": "backstage-cli repo clean",
    "test": "backstage-cli repo test --watchAll=false",
    "test:watch": "backstage-cli repo test",
    "test:all": "backstage-cli repo test --coverage --maxWorkers=${JEST_MAX_WORKERS:-40%} --workerIdleMemoryLimit=1024MB",
    "test:e2e": "scripts/no-core-dumps.sh playwright test",
    "test:e2e:agentlab": "playwright install chromium && scripts/no-core-dumps.sh playwright test --config e2e/agentlab/playwright.config.ts",
    "fix": "backstage-cli repo fix",
    "lint": "backstage-cli repo lint --since origin/main && yarn run lint:e2e",
    "lint:all": "backstage-cli repo lint && yarn run lint:e2e",
    "lint:e2e": "eslint e2e",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "ci:lint": "yarn run lint:all && yarn run prettier:check",
    "ci:patches": "yarn patch-package --error-on-fail",
    "ci:workspace-links": "node scripts/check-workspace-links.mjs",
    "ci:verify": "yarn run ci:patches && concurrently --group --names test,tsc,lint -c green,blue,magenta \"yarn run test:all\" \"yarn run tsc --noEmit\" \"yarn run ci:lint\"",
    "ci:build": "yarn run ci:patches && yarn run ci:workspace-links && touch github-app-credentials.yaml && NODE_ENV=production yarn run build:backend --config ../../app-config.yaml --config ../../app-config.production.yaml && NODE_ENV=production yarn run build:backend-headless-service --config ../../app-config.yaml --config ../../app-config.production.yaml",
    "new": "backstage-cli new",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static",
    "storybook:coverage": "tsx scripts/check-story-coverage.mts",
    "typecheck:storybook": "scripts/no-core-dumps.sh tsc -p tsconfig.storybook.json",
    "release:version": "changeset version && yarn install --mode=update-lockfile && prettier --write '{packages,plugins}/*/{package.json,CHANGELOG.md}'",
    "release:publish": "yarn tsc && backstage-cli repo build && changeset publish",
    "postinstall": "yarn patch-package --error-on-fail",
    "prepare": "husky"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "plugins/*"
    ]
  },
  "devDependencies": {
    "@backstage/cli": "backstage:^",
    "@backstage/cli-defaults": "backstage:^",
    "@backstage/e2e-test-utils": "backstage:^",
    "@changesets/cli": "^3.0.0",
    "@jest/environment-jsdom-abstract": "^30.0.0",
    "@playwright/test": "^1.32.3",
    "@storybook/addon-docs": "^10.5.3",
    "@storybook/react-vite": "^10.5.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
