    "@yarnpkg/cli@npm:^4.7.0": "4.18.1",
    "@backstage/backend-defaults@backstage:^": "patch:@backstage/backend-defaults@npm%3A0.18.0#~/.yarn/patches/@backstage-backend-defaults-npm-0.18.0-38f210e7c4.patch"
  },
  "jest": {
    "cacheDirectory": "<rootDir>/../../../node_modules/.cache/jest",
    "setupFiles": [
      "<rootDir>/../../../jest.setup.js"
    ]
  },
  "prettier": "@backstage/cli/config/prettier",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "patch-package": "^8.0.0",
    "postinstall-postinstall": "^2.1.0"
  },
  "packageManager": "yarn@4.18.1"
