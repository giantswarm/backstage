{
  "extends": "@backstage/cli/config/tsconfig.json",
  "include": [
    "packages/*/src",
    "packages/*/config.d.ts",
    "plugins/*/src",
    "plugins/*/config.d.ts",
    "plugins/*/dev",
    "plugins/*/migrations",
    "e2e/agentlab"
  ],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "outDir": "dist-types",
    "tsBuildInfoFile": "node_modules/.cache/tsc/tsconfig.tsbuildinfo",
    "rootDir": ".",
    "jsx": "react-jsx",
    "moduleResolution": "bundler"
  },
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs"
    }
  }
}
