{
  "name": "@giantswarm/backstage-plugin-gs-node",
  "description": "Common node-side functionalities for the GS plugins",
  "version": "0.3.1",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "node-library",
    "pluginId": "gs",
    "pluginPackages": [
      "@giantswarm/backstage-plugin-gs",
      "@giantswarm/backstage-plugin-gs-backend",
      "@giantswarm/backstage-plugin-gs-common",
      "@giantswarm/backstage-plugin-gs-node",
      "@giantswarm/backstage-plugin-gs-react"
    ]
  },
  "sideEffects": false,
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test --watchAll=false",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.14",
    "@backstage/backend-plugin-api": "backstage:^",
    "@backstage/config": "backstage:^",
    "@backstage/errors": "backstage:^",
    "@backstage/types": "backstage:^",
    "@giantswarm/backstage-plugin-gs-common": "^0.21.1",
    "@giantswarm/semver-ts": "github:giantswarm/semver-ts#v0.1.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@backstage/backend-test-utils": "backstage:^",
    "@backstage/cli": "backstage:^"
  },
  "files": [
    "dist"
  ],
  "bugs": "https://github.com/giantswarm/backstage/issues",
  "author": "Giant Swarm"
}
