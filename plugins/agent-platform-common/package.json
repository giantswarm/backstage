{
  "name": "@giantswarm/backstage-plugin-agent-platform-common",
  "description": "Shared kagent wire schemas and session-state semantics for the Agent Platform plugins",
  "version": "0.1.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testFixtures": "./src/testFixtures.ts",
    "./package.json": "./package.json"
  },
  "license": "Apache-2.0",
  "private": true,
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "module": "dist/index.esm.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "common-library"
  },
  "sideEffects": false,
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test --watchAll=false",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@backstage/cli": "backstage:^"
  },
  "files": [
    "dist"
  ],
  "bugs": "https://github.com/giantswarm/backstage/issues",
  "author": "Giant Swarm",
  "typesVersions": {
    "*": {
      "testFixtures": [
        "src/testFixtures.ts"
      ]
    }
  }
}
